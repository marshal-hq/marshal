<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.marshalhq.demo</groupId>
  <artifactId>demo-project</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>

  <!--
    Demo fixture for Marshal.
    Metadata is pre-populated in marshal-cache.db (see README.md).
    Expected output when run against the demo cache:
      GREEN  : commons-lang3 3.14.0  (score 0)
      GREEN  : slf4j-api 2.0.12      (score 0)
      ORANGE : commons-io 2.16.1     (score 55 — signature dropped)
      RED    : jackson-databind 2.17.0 (score 90 — new maintainer + signature dropped)
      GREEN  : spring-core 6.1.4     (score 0)
  -->

  <dependencies>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-lang3</artifactId>
      <version>3.14.0</version>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.12</version>
    </dependency>

    <!-- ORANGE: signature dropped between 2.15.1 and 2.16.1 in the demo cache -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-io</artifactId>
      <version>2.16.1</version>
    </dependency>

    <!-- RED: new maintainer + signature dropped in the demo cache -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.0</version>
    </dependency>

    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-core</artifactId>
      <version>6.1.4</version>
    </dependency>
  </dependencies>

</project>
